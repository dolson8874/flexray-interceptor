+++ b/openpilot/system/flexray_logd/tests/test_flexrayd.py
@@ -27,6 +27,17 @@ def envelope(frame_id=0x47F, flags=3, cycle=7, payload=b'\x12\x34', crc=0x123456
   return b'\x04' + (frame_id << 3).to_bytes(4, 'little') + bytes([len(payload) // 2, flags, cycle]) + payload + crc.to_bytes(3, 'big')


+def test_source5_envelope_all_split_positions():
+  data = bytearray(envelope(frame_id=0x1f))
+  data[0] = 2  # wire bus1 -> host source5
+  for split in range(len(data)):
+    pending = bytearray(data[:split])
+    assert unpack_frames(pending) == []
+    pending.extend(data[split:])
+    frames = unpack_frames(pending)
+    assert not pending and frames == [{'address': 0x1f, 'src': 5, 'dat': bytes(data[6:])}]
+
+
